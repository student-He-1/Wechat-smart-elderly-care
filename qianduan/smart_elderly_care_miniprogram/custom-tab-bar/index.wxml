<!-- custom-tab-bar/index.wxml -->
<view class="tabbar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item {{selected === index ? 'is-active' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="ic ic-48 {{selected === index ? item.iconOn : item.icon}}"></view>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
