/* custom-tab-bar/index.wxss */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  box-sizing: border-box; /* height 已含安全区，防止实际高度多出一倍安全区遮挡内容 */
  height: calc(104rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 -4rpx 24rpx rgba(15, 42, 61, 0.06);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding-top: 8rpx;
}

.tab-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #94a3b8;
  transition: color 0.15s ease;
}

.tab-item.is-active .tab-text {
  color: #0369a1;
  font-weight: 700;
}

.tab-item:active {
  opacity: 0.75;
}
