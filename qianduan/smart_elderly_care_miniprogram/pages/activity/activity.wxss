/* activity.wxss */
.act-page { padding: 20rpx 28rpx 60rpx; }
.act-list { display: flex; flex-direction: column; gap: 20rpx; }

.act-card {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(15,42,61,0.06);
  overflow: hidden;
}

.act-img {
  height: 240rpx;
  background: #1f2937;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.act-img-el { width: 100%; height: 240rpx; }
.act-img-text { font-size: 24rpx; color: rgba(255,255,255,0.4); }

.act-body { padding: 24rpx; }
.act-title { display: block; font-size: 32rpx; font-weight: 600; color: #0f172a; }
.act-desc { display: block; margin-top: 10rpx; font-size: 26rpx; color: #475569; line-height: 1.5; }
.act-meta { margin-top: 14rpx; display: flex; gap: 20rpx; }
.act-time, .act-loc { font-size: 22rpx; color: #64748b; }
.act-foot { margin-top: 16rpx; display: flex; justify-content: space-between; align-items: center; }
.act-tag { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 6rpx; background: #e0f2fe; color: #0369a1; }
.act-btn { padding: 12rpx 28rpx; border-radius: 999rpx; background: #0369a1; color: #fff; font-size: 24rpx; font-weight: 600; }
.act-btn--joined { background: #dcfce7; color: #15803d; }
