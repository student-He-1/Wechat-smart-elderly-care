/* daughter/home.wxss —— 子女端首页 */
.daughter-page {
  padding: 16rpx 28rpx 200rpx;
}

.daughter-hero {
  margin: 8rpx -28rpx 24rpx;
  padding: 48rpx 48rpx 56rpx;
  background: linear-gradient(180deg, var(--brand-100) 0%, rgba(224, 242, 254, 0) 100%);
}

.daughter-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.daughter-title {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--ink-900);
}

.daughter-back {
  font-size: 26rpx;
  color: var(--brand-600);
  padding: 12rpx 24rpx;
  background: #ffffff;
  border-radius: 999rpx;
  box-shadow: var(--shadow-card);
}

.daughter-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--ink-600);
}

/* 状态卡 */
.status-card {
  background: var(--color-card);
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--color-hairline);
}

.status-row--last {
  border-bottom: none;
}

.status-label {
  font-size: 28rpx;
  color: var(--ink-600);
}

.status-value-wrap {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.status-value {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink-900);
}

.status-unit {
  font-size: 24rpx;
  color: var(--ink-500);
}

.status-badge {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.status-badge--ok {
  background: var(--safe-soft);
  color: #15803d;
}

.status-badge--alert {
  background: #ffe4e6;
  color: #b91c1c;
}

/* 分区标题 */
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 40rpx 4rpx 20rpx;
}

.sec-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink-900);
}

.sec-count {
  font-size: 24rpx;
  color: #b91c1c;
}

/* 快捷操作 4 列 */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.quick-cell {
  background: var(--color-card);
  border-radius: 20rpx;
  box-shadow: var(--shadow-card);
  padding: 28rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-cell--press {
  opacity: 0.8;
}

.quick-ic {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
}

.quick-ic--blue  { background: var(--brand-100); }
.quick-ic--green { background: var(--safe-soft); }
.quick-ic--cyan  { background: #cffafe; }
.quick-ic--amber { background: var(--warn-soft); }

.quick-label {
  font-size: 24rpx;
  color: var(--ink-700);
}

/* 告警列表 */
.alert-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.alert-card {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: var(--color-card);
  box-shadow: var(--shadow-card);
}

.alert-card--urgent {
  border-left: 8rpx solid #dc2626;
}

.alert-card--normal {
  border-left: 8rpx solid #f59e0b;
}

.alert-ic {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #fee2e2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.alert-card--normal .alert-ic {
  background: #fef3c7;
}

.alert-body {
  flex: 1;
  margin-left: 20rpx;
}

.alert-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-900);
}

.alert-time {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ink-500);
}

.alert-action {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: var(--brand-600);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
}

.alert-empty {
  padding: 80rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.alert-empty-text {
  font-size: 26rpx;
  color: var(--ink-500);
}

/* 养老信息 */
.news-list {
  background: var(--color-card);
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
  padding: 8rpx 28rpx;
}

.news-item {
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--color-hairline);
}

.news-item--last { border-bottom: none; }
.news-title { display: block; font-size: 28rpx; color: var(--ink-900); line-height: 1.5; }
.news-item--press { background: #f8fafc; }
.sec-more { font-size: 24rpx; color: var(--ink-500); }
.sec-head { display: flex; align-items: center; justify-content: space-between; margin: 32rpx 4rpx 20rpx; }

.msg-card {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(15,42,61,0.06);
  padding: 28rpx;
  margin-bottom: 8rpx;
}
.msg-card--press { opacity: 0.9; }
.msg-preview { display: block; font-size: 28rpx; color: #0f172a; line-height: 1.5; }
.msg-time { display: block; margin-top: 10rpx; font-size: 22rpx; color: #94a3b8; }

/* 底部导航 */
.d-tabbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 999;
  display: flex;
  height: calc(104rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  box-shadow: 0 -4rpx 24rpx rgba(15,42,61,0.06);
}

.d-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.d-tab-icon { font-size: 40rpx; }
.d-tab-text { font-size: 24rpx; color: #94a3b8; }
.d-tab--active .d-tab-text { color: #0369a1; font-weight: 700; }
