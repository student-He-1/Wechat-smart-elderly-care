/* daughter/services.wxss */
.svc-page {
  padding: 16rpx 28rpx 200rpx;
}

.search-bar {
  margin: 8rpx 0 20rpx;
}

.search-box {
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 28rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(15,42,61,0.06);
}

.search-icon { margin-right: 16rpx; font-size: 28rpx; }
.search-placeholder { font-size: 26rpx; color: #94a3b8; }

.type-tabs {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.type-tab {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: #ffffff;
  font-size: 26rpx;
  color: #475569;
}

.type-tab--active {
  background: #0369a1;
  color: #fff;
  font-weight: 600;
}

.area-tabs {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.area-tab {
  display: inline-block;
  margin-right: 24rpx;
  font-size: 26rpx;
  color: #64748b;
}

.area-tab:first-child {
  color: #0369a1;
  font-weight: 600;
}

.org-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.org-card {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(15,42,61,0.06);
  padding: 24rpx;
}

.org-img {
  width: 160rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #1f2937;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}
.org-img-el { width: 100%; height: 120rpx; }
.org-img-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
}

.org-body {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.org-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}

.org-tags {
  margin-top: 8rpx;
  display: flex;
  gap: 10rpx;
}

.org-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: #e0f2fe;
  color: #0369a1;
}

.org-tag--green {
  background: #dcfce7;
  color: #15803d;
}

.org-addr {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #475569;
}

.org-area {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.org-call {
  align-self: center;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #0369a1;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.d-tabbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 999;
  display: flex;
  height: calc(104rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  box-shadow: 0 -4rpx 24rpx rgba(15,42,61,0.06);
}

.d-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.d-tab-icon { font-size: 40rpx; }
.d-tab-text { font-size: 24rpx; color: #94a3b8; }
.d-tab--active .d-tab-text { color: #0369a1; font-weight: 700; }
