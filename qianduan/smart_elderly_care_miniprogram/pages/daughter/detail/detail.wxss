/* daughter/detail.wxss */
.detail-page {
  padding: 16rpx 28rpx 60rpx;
}

.profile-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  margin-top: 8rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #075985, #0ea5e9);
  box-shadow: 0 12rpx 32rpx rgba(3, 105, 161, 0.28);
}

.profile-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 28rpx;
  background: rgba(255,255,255,0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 600;
  color: #fff;
}

.profile-info { margin-left: 24rpx; }
.profile-name { display:block; font-size: 38rpx; font-weight: 600; color: #fff; }
.profile-meta { display:block; margin-top: 8rpx; font-size: 24rpx; color: rgba(255,255,255,0.8); }

.sec-head { margin: 40rpx 4rpx 20rpx; }
.sec-title { font-size: 34rpx; font-weight: 600; color: var(--ink-900); }

.list-group {
  background: var(--color-card);
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--color-hairline);
}

.info-row--last { border-bottom: none; }
.info-label { font-size: 26rpx; color: var(--ink-600); }
.info-value { font-size: 26rpx; color: var(--ink-900); font-weight: 500; }

.record-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.record-cell {
  background: var(--color-card);
  border-radius: 20rpx;
  box-shadow: var(--shadow-card);
  padding: 28rpx;
  text-align: center;
}

.record-value { display:block; font-size: 40rpx; font-weight: 600; color: var(--ink-900); }
.record-label { display:block; margin-top: 6rpx; font-size: 22rpx; color: var(--ink-500); }
