<!-- daughter/detail.wxml —— 老人详情页 -->
<view class="detail-page {{dark ? 'dark' : ''}}">

  <!-- 老人档案卡 -->
  <view class="profile-card">
    <view class="profile-avatar">张</view>
    <view class="profile-info">
      <text class="profile-name">张奶奶</text>
      <text class="profile-meta">72 岁 · 女 · 高血压</text>
    </view>
  </view>

  <!-- 档案信息 -->
  <view class="sec-head"><text class="sec-title">基本档案</text></view>
  <view class="list-group">
    <view class="info-row"><text class="info-label">出生日期</text><text class="info-value">1954 年 3 月</text></view>
    <view class="info-row"><text class="info-label">血型</text><text class="info-value">A 型</text></view>
    <view class="info-row"><text class="info-label">慢病</text><text class="info-value">高血压 · 2 型糖尿病</text></view>
    <view class="info-row"><text class="info-label">过敏史</text><text class="info-value">青霉素</text></view>
    <view class="info-row"><text class="info-label">居住地址</text><text class="info-value">天津市和平区XX小区 3-2-501</text></view>
    <view class="info-row info-row--last"><text class="info-label">紧急联系人</text><text class="info-value">儿子 张先生 138****8888</text></view>
  </view>

  <!-- 最近健康记录 -->
  <view class="sec-head"><text class="sec-title">最近健康记录</text></view>
  <view class="record-grid">
    <view class="record-cell">
      <text class="record-value">138/86</text>
      <text class="record-label">血压 mmHg</text>
    </view>
    <view class="record-cell">
      <text class="record-value">7.2</text>
      <text class="record-label">血糖 mmol/L</text>
    </view>
    <view class="record-cell">
      <text class="record-value">65</text>
      <text class="record-label">心率</text>
    </view>
    <view class="record-cell">
      <text class="record-value">62.4</text>
      <text class="record-label">体重 kg</text>
    </view>
  </view>

  <!-- 用药计划 -->
  <view class="sec-head"><text class="sec-title">今日用药计划</text></view>
  <view class="list-group">
    <view class="info-row">
      <text class="info-label">缬沙坦 80mg</text>
      <text class="info-value">08:00 · 已吃</text>
    </view>
    <view class="info-row">
      <text class="info-label">二甲双胍 0.5g</text>
      <text class="info-value">12:00 · 已吃</text>
    </view>
    <view class="info-row info-row--last">
      <text class="info-label">缬沙坦 80mg</text>
      <text class="info-value">18:00 · 待吃</text>
    </view>
  </view>

</view>
