/* pages/companion/audiobook/audiobook.wxss */
.page-audiobook {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0fdfa 0%, #ffffff 40%);
  padding: 32rpx 28rpx 40rpx;
  box-sizing: border-box;
}
.ab-header { margin-bottom: 24rpx; }
.ab-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 4rpx;
}
.ab-sub {
  display: block;
  font-size: 26rpx;
  color: #64748b;
}

/* 分类tab */
.cat-bar { white-space: nowrap; margin-bottom: 24rpx; }
.cat-list { display: inline-flex; gap: 16rpx; }
.cat-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 26rpx;
  background: #fff;
  border: 2rpx solid #e2e8f0;
  border-radius: 999rpx;
}
.cat-chip--active {
  background: #ccfbf1;
  border-color: #2dd4bf;
}
.cat-icon { font-size: 28rpx; }
.cat-name { font-size: 26rpx; color: #64748b; font-weight: 600; }
.cat-chip--active .cat-name { color: #0f766e; }

/* 当前播放 */
.now-playing {
  display: flex;
  align-items: flex-start;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(13, 148, 136, 0.08);
  margin-bottom: 24rpx;
}
.np-cover {
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #5eead4, #0d9488);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.np-cover-icon { font-size: 64rpx; }
.np-info { flex: 1; min-width: 0; }
.np-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.np-author {
  display: block;
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 12rpx;
}
.np-progress { margin: 0 -8rpx; }
.np-slider { width: 100%; }
.np-time {
  display: flex;
  justify-content: space-between;
  margin-top: -4rpx;
}
.time-text { font-size: 22rpx; color: #94a3b8; }

/* 播放控制 */
.controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 32rpx;
}
.ctrl-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.ctrl-btn--big {
  width: 88rpx;
  height: 88rpx;
  background: #f0fdfa;
}
.ctrl-btn--play {
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, #2dd4bf, #0d9488);
  box-shadow: 0 6rpx 20rpx rgba(13, 148, 136, 0.3);
}
.ctrl-icon { font-size: 36rpx; color: #0d9488; }
.ctrl-icon--large { font-size: 48rpx; color: #fff; }

/* 曲目列表 */
.track-list {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(13, 148, 136, 0.06);
  margin-bottom: 24rpx;
}
.sec-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.sec-title { font-size: 30rpx; font-weight: 700; color: #0f172a; }
.sec-count { font-size: 24rpx; color: #94a3b8; }
.track-item {
  display: flex;
  align-items: center;
  padding: 20rpx 12rpx;
  border-radius: 12rpx;
  border-bottom: 1rpx solid #f1f5f9;
}
.track-item:last-child { border-bottom: none; }
.track-item--active { background: #f0fdfa; }
.track-index {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.index-text { font-size: 26rpx; color: #94a3b8; font-weight: 600; }
.playing-indicator { font-size: 28rpx; color: #0d9488; }
.track-info { flex: 1; min-width: 0; }
.track-title {
  display: block;
  font-size: 28rpx;
  color: #0f172a;
  font-weight: 600;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.track-item--active .track-title { color: #0d9488; }
.track-author { display: block; font-size: 22rpx; color: #94a3b8; }
.track-play {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.track-play-ic { font-size: 28rpx; color: #0d9488; }

.tip-bar {
  background: #fefce8;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.tip-text { font-size: 22rpx; color: #a16207; line-height: 1.5; }
