/* pages/companion/diary/diary.wxss */
.page-diary {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0fdf4 0%, #ffffff 40%);
  padding: 32rpx 28rpx 40rpx;
  box-sizing: border-box;
}
.diary-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.header-left { display: flex; flex-direction: column; }
.diary-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 4rpx;
}
.diary-count {
  font-size: 26rpx;
  color: #94a3b8;
}
.write-btn {
  height: 80rpx;
  font-size: 28rpx;
  padding: 0 28rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #4ade80, #16a34a);
  color: #fff;
}

/* 筛选栏 */
.filter-bar {
  white-space: nowrap;
  margin-bottom: 24rpx;
}
.filter-list {
  display: inline-flex;
  gap: 16rpx;
}
.filter-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  background: #fff;
  border: 2rpx solid #e2e8f0;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #64748b;
}
.filter-chip--active {
  background: #dcfce7;
  border-color: #4ade80;
  color: #16a34a;
  font-weight: 600;
}

/* 日记列表 */
.diary-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.diary-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(34, 197, 94, 0.06);
}
.diary-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.diary-mood {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.diary-emoji { font-size: 44rpx; }
.diary-mood-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}
.diary-date {
  text-align: right;
}
.date-text {
  display: block;
  font-size: 26rpx;
  color: #64748b;
}
.time-text {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
}
.diary-content {
  font-size: 30rpx;
  color: #334155;
  line-height: 1.7;
  margin-bottom: 16rpx;
}
.diary-actions {
  display: flex;
  justify-content: flex-end;
}
.delete-btn {
  font-size: 26rpx;
  color: #ef4444;
  padding: 8rpx 20rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-emoji { font-size: 96rpx; margin-bottom: 20rpx; }
.empty-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #64748b;
  margin-bottom: 8rpx;
}
.empty-desc {
  font-size: 26rpx;
  color: #94a3b8;
}

/* 写日记弹窗 */
.editor-mask {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 999;
}
.editor-card {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx 48rpx;
  box-sizing: border-box;
  max-height: 85vh;
  overflow-y: auto;
}
.editor-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}
.editor-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
}
.editor-close {
  font-size: 36rpx;
  color: #94a3b8;
  padding: 8rpx;
}

/* 心情选择 */
.mood-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.mood-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  background: #f8fafc;
  border: 4rpx solid #e2e8f0;
  border-radius: 16rpx;
  transition: all 0.15s;
}
.mood-item--active {
  background: #f0fdf4;
  transform: scale(1.05);
}
.mood-emoji { font-size: 48rpx; margin-bottom: 6rpx; }
.mood-text { font-size: 24rpx; color: #475569; font-weight: 600; }

/* 文本域 */
.diary-textarea {
  width: 100%;
  min-height: 200rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #0f172a;
  line-height: 1.7;
  box-sizing: border-box;
  margin-bottom: 28rpx;
}
.textarea-placeholder {
  color: #94a3b8;
  font-size: 28rpx;
}

.editor-footer {
  display: flex;
  gap: 20rpx;
}
.cancel-btn {
  flex: 1;
  height: 88rpx;
  font-size: 32rpx;
  border-radius: 44rpx;
  background: #f1f5f9;
  color: #64748b;
}
.save-btn {
  flex: 2;
  height: 88rpx;
  font-size: 32rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #4ade80, #16a34a);
  color: #fff;
}
