/* pages/companion/game/index/index.wxss */
.page-game-select {
  min-height: 100vh;
  background: linear-gradient(180deg, #eff6ff 0%, #ffffff 40%);
  padding: 32rpx 28rpx 40rpx;
  box-sizing: border-box;
}
.hero {
  margin-bottom: 36rpx;
}
.hero-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 8rpx;
}
.hero-sub {
  display: block;
  font-size: 28rpx;
  color: #64748b;
}
.game-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 32rpx;
}
.game-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.15s;
}
.game-card--press {
  transform: scale(0.97);
}
.game-card--green {
  border-left: 8rpx solid #4ade80;
}
.game-card--blue {
  border-left: 8rpx solid #60a5fa;
}
.game-card--purple {
  border-left: 8rpx solid #c084fc;
}
.game-card--orange {
  border-left: 8rpx solid #fb923c;
}
.game-card--cyan {
  border-left: 8rpx solid #22d3ee;
}
.game-icon {
  font-size: 72rpx;
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
  border-radius: 20rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.game-body {
  flex: 1;
  min-width: 0;
}
.game-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 8rpx;
}
.game-desc {
  display: block;
  font-size: 26rpx;
  color: #94a3b8;
  line-height: 1.4;
}
.game-arrow {
  font-size: 48rpx;
  color: #cbd5e1;
  margin-left: 16rpx;
  flex-shrink: 0;
}
.tip-bar {
  background: #fefce8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}
.tip-text {
  font-size: 24rpx;
  color: #a16207;
  line-height: 1.5;
}
