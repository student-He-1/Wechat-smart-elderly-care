/* pages/companion/game/math/math.wxss */
.page-math {
  min-height: 100vh;
  background: linear-gradient(180deg, #ecfeff 0%, #ffffff 40%);
  padding: 32rpx 28rpx 40rpx;
  box-sizing: border-box;
}
.math-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(6, 182, 212, 0.08);
  margin-bottom: 28rpx;
}
.header-item {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}
.header-label { font-size: 26rpx; color: #94a3b8; }
.header-value { font-size: 40rpx; font-weight: 700; color: #0f172a; }
.header-value--score { color: #0891b2; }
.header-level { font-size: 30rpx; font-weight: 600; color: #0e7490; }

.question-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(6, 182, 212, 0.1);
  margin-bottom: 32rpx;
  border: 4rpx solid #cffafe;
}
.question-text {
  font-size: 72rpx;
  font-weight: 700;
  color: #0f172a;
  letter-spacing: 8rpx;
}

.options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 28rpx;
}
.option-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 130rpx;
  background: #fff;
  border: 4rpx solid #a5f3fc;
  border-radius: 20rpx;
  position: relative;
  transition: all 0.15s;
}
.option-btn:active {
  transform: scale(0.95);
  background: #ecfeff;
}
.option-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #0e7490;
}
.option--correct {
  background: #f0fdf4 !important;
  border-color: #4ade80 !important;
}
.option--correct .option-num { color: #16a34a; }
.option--wrong {
  background: #fef2f2 !important;
  border-color: #f87171 !important;
}
.option--wrong .option-num { color: #ef4444; }
.option-mark {
  position: absolute;
  right: 20rpx;
  top: 16rpx;
  font-size: 36rpx;
  color: #16a34a;
  font-weight: 700;
}
.option-mark--wrong { color: #ef4444; }

.feedback {
  text-align: center;
  margin-bottom: 24rpx;
}
.feedback-text { font-size: 32rpx; font-weight: 600; }
.feedback--correct { color: #16a34a; }
.feedback--wrong { color: #ef4444; }

.next-wrap {
  display: flex;
  justify-content: center;
}
.next-btn {
  min-width: 320rpx;
  height: 96rpx;
  font-size: 34rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #22d3ee, #0891b2);
  color: #fff;
}

.complete-mask {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.complete-card {
  width: 560rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.complete-emoji { font-size: 96rpx; margin-bottom: 16rpx; }
.complete-title { font-size: 44rpx; font-weight: 700; color: #0891b2; margin-bottom: 16rpx; }
.complete-desc { font-size: 30rpx; color: #475569; margin-bottom: 8rpx; }
.complete-encourage { font-size: 28rpx; color: #94a3b8; margin-bottom: 32rpx; text-align: center; line-height: 1.5; }
.complete-btn {
  width: 100%;
  height: 96rpx;
  font-size: 34rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #22d3ee, #0891b2);
  color: #fff;
}
.complete-btn-ghost {
  width: 100%;
  height: 80rpx;
  font-size: 30rpx;
  border-radius: 40rpx;
  background: transparent;
  color: #94a3b8;
  margin-top: 16rpx;
}
