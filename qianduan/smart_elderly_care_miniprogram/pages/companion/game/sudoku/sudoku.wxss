/* pages/companion/game/sudoku/sudoku.wxss */
.page-sudoku {
  min-height: 100vh;
  background: linear-gradient(180deg, #eff6ff 0%, #ffffff 40%);
  padding: 32rpx 28rpx 40rpx;
  box-sizing: border-box;
}

.sudoku-header {
  text-align: center;
  margin-bottom: 32rpx;
}
.sudoku-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 12rpx;
}
.sudoku-desc {
  display: block;
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.5;
}

/* 数独棋盘 */
.sudoku-board {
  width: 560rpx;
  margin: 0 auto 36rpx;
  border: 6rpx solid #3b82f6;
  border-radius: 16rpx;
  overflow: hidden;
  background: #fff;
}
.sudoku-row {
  display: flex;
}
.sudoku-cell {
  flex: 1;
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #dbeafe;
  box-sizing: border-box;
  transition: background 0.15s;
}
.cell--light { background: #fff; }
.cell--dark { background: #eff6ff; }
.cell--selected {
  background: #dbeafe !important;
  box-shadow: inset 0 0 0 4rpx #3b82f6;
}
.cell--fixed { cursor: default; }
.cell--error {
  background: #fef2f2 !important;
}
.cell--error .num--user {
  color: #ef4444;
}
.cell-num {
  font-size: 48rpx;
  font-weight: 700;
}
.num--fixed { color: #1e40af; }
.num--user { color: #0ea5e9; }

/* 数字键盘 */
.num-pad {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.num-btn {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border: 3rpx solid #93c5fd;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.1);
}
.num-btn:active {
  background: #dbeafe;
  transform: scale(0.92);
}
.num-btn--clear {
  background: #fef3c7;
  border-color: #fcd34d;
}
.num-btn--clear .num-btn-text {
  font-size: 26rpx;
  color: #92400e;
}
.num-btn-text {
  font-size: 44rpx;
  font-weight: 700;
  color: #1d4ed8;
}

/* 底部操作 */
.sudoku-footer {
  display: flex;
  justify-content: center;
  gap: 24rpx;
}
.footer-btn {
  min-width: 200rpx;
  height: 88rpx;
  font-size: 30rpx;
  border-radius: 44rpx;
  background: #fff;
  color: #1d4ed8;
  border: 2rpx solid #93c5fd;
}

/* 完成弹窗 */
.complete-mask {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.complete-card {
  width: 560rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.complete-emoji { font-size: 96rpx; margin-bottom: 16rpx; }
.complete-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1d4ed8;
  margin-bottom: 16rpx;
}
.complete-desc { font-size: 30rpx; color: #475569; margin-bottom: 8rpx; }
.complete-encourage { font-size: 28rpx; color: #94a3b8; margin-bottom: 32rpx; }
.complete-btn {
  width: 100%;
  height: 96rpx;
  font-size: 34rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #60a5fa, #2563eb);
  color: #fff;
}
.complete-btn-ghost {
  width: 100%;
  height: 80rpx;
  font-size: 30rpx;
  border-radius: 40rpx;
  background: transparent;
  color: #94a3b8;
  margin-top: 16rpx;
}
