/* pages/companion/game/memory/memory.wxss */
.page-memory {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0fdf4 0%, #ffffff 40%);
  padding: 32rpx 28rpx 40rpx;
  box-sizing: border-box;
}

/* 顶部信息栏 */
.game-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(34, 197, 94, 0.08);
  margin-bottom: 24rpx;
}
.header-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 120rpx;
}
.header-label {
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 4rpx;
}
.header-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #16a34a;
}
.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
}

/* 游戏说明 */
.game-tip {
  background: #f0fdf4;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 28rpx;
}
.tip-text {
  font-size: 26rpx;
  color: #166534;
  line-height: 1.5;
}

/* 卡片网格 4x4 */
.card-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.card-wrapper {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 100%;
  perspective: 800rpx;
}
.card {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 0.5s ease;
  border-radius: 16rpx;
}
.card--flipped {
  transform: rotateY(180deg);
}
.card-face {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  backface-visibility: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
}
.card-face--back {
  background: linear-gradient(135deg, #86efac, #4ade80);
  box-shadow: 0 4rpx 12rpx rgba(34, 197, 94, 0.2);
}
.card-back-icon {
  font-size: 48rpx;
}
.card-face--front {
  background: #fff;
  border: 4rpx solid #bbf7d0;
  transform: rotateY(180deg);
}
.card-front-icon {
  font-size: 64rpx;
}
.card--matched .card-face--front {
  background: #f0fdf4;
  border-color: #4ade80;
}
.card--matched {
  animation: cardVanish 0.4s ease forwards;
  pointer-events: none;
}
@keyframes cardVanish {
  0% { transform: rotateY(180deg) scale(1); opacity: 1; }
  100% { transform: rotateY(180deg) scale(0.3); opacity: 0; }
}

/* 底部操作 */
.game-footer {
  display: flex;
  justify-content: center;
  padding: 20rpx 0;
}
.restart-btn {
  min-width: 280rpx;
  height: 88rpx;
  font-size: 32rpx;
  border-radius: 44rpx;
  background: #fff;
  color: #16a34a;
  border: 2rpx solid #bbf7d0;
}

/* 完成弹窗 */
.complete-mask {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.complete-card {
  width: 560rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.complete-emoji {
  font-size: 96rpx;
  margin-bottom: 16rpx;
}
.complete-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #16a34a;
  margin-bottom: 16rpx;
}
.complete-desc {
  font-size: 30rpx;
  color: #475569;
  margin-bottom: 8rpx;
}
.complete-encourage {
  font-size: 28rpx;
  color: #94a3b8;
  margin-bottom: 32rpx;
}
.complete-btn {
  width: 100%;
  height: 96rpx;
  font-size: 34rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #4ade80, #16a34a);
  color: #fff;
}
.complete-btn-ghost {
  width: 100%;
  height: 80rpx;
  font-size: 30rpx;
  border-radius: 40rpx;
  background: transparent;
  color: #94a3b8;
  margin-top: 16rpx;
}
