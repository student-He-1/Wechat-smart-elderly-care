/* pages/companion/album/album.wxss */
.page-album {
  min-height: 100vh;
  background: linear-gradient(180deg, #fdf2f8 0%, #ffffff 40%);
  padding: 32rpx 28rpx 40rpx;
  box-sizing: border-box;
}
.album-header {
  margin-bottom: 20rpx;
}
.album-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 8rpx;
}
.album-count {
  display: block;
  font-size: 28rpx;
  color: #94a3b8;
}

.album-tip {
  background: #fdf2f8;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 28rpx;
}
.tip-text {
  font-size: 26rpx;
  color: #be185d;
  line-height: 1.5;
}

/* 照片网格 2列 */
.photo-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 32rpx;
}
.photo-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(236, 72, 153, 0.08);
  transition: transform 0.15s;
}
.photo-card--press {
  transform: scale(0.96);
}
.photo-img {
  width: 100%;
  height: 320rpx;
  display: block;
  background: #fce7f3;
}
.photo-info {
  padding: 16rpx 20rpx 20rpx;
}
.photo-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 4rpx;
}
.photo-desc {
  display: block;
  font-size: 24rpx;
  color: #94a3b8;
}

.album-footer {
  text-align: center;
  padding: 20rpx 0;
}
.footer-text {
  font-size: 24rpx;
  color: #cbd5e1;
}

/* 全屏大图预览 */
.preview-mask {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0, 0, 0, 0.92);
  z-index: 999;
  display: flex;
  flex-direction: column;
}
.preview-close {
  position: absolute;
  top: 60rpx;
  right: 40rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50%;
  color: #fff;
  font-size: 36rpx;
  z-index: 10;
}
.preview-swiper {
  flex: 1;
  width: 100%;
}
.preview-item {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx 160rpx;
  box-sizing: border-box;
}
.preview-img {
  max-width: 100%;
  max-height: 70vh;
  border-radius: 16rpx;
}
.preview-caption {
  margin-top: 32rpx;
  text-align: center;
}
.preview-name {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}
.preview-desc {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}
.preview-indicator {
  position: absolute;
  bottom: 60rpx;
  left: 0;
  width: 100%;
  text-align: center;
}
.indicator-text {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(0, 0, 0, 0.4);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}
