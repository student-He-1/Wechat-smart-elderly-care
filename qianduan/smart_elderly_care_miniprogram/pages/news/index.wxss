/* news/index.wxss */
.news-page { padding: 20rpx 28rpx 60rpx; }

.news-list {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15,42,61,0.06);
  padding: 8rpx 32rpx;
}

.news-card {
  padding: 32rpx 0;
  border-bottom: 1rpx solid #e5e7eb;
}

.news-card:last-child { border-bottom: none; }
.news-card--press { background: #f8fafc; }

.news-title {
  display: block;
  font-size: 30rpx;
  color: #0f172a;
  line-height: 1.5;
  font-weight: 500;
}

.news-meta {
  margin-top: 12rpx;
  display: flex;
  gap: 20rpx;
}

.news-date { font-size: 22rpx; color: #94a3b8; }
.news-source { font-size: 22rpx; color: #94a3b8; }
