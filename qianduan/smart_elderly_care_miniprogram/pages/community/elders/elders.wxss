/* community/elders.wxss */
.e-page { padding: 20rpx 28rpx 200rpx; }
.e-list { display: flex; flex-direction: column; gap: 20rpx; }
.e-card { display: flex; align-items: center; background: #fff; border-radius: 20rpx; padding: 28rpx; box-shadow: 0 4rpx 16rpx rgba(15,42,61,0.06); }
.e-avatar { width: 88rpx; height: 88rpx; border-radius: 20rpx; background: #b45309; color: #fff; font-size: 36rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; }
.e-avatar-img { width: 100%; height: 88rpx; }
.e-body { flex: 1; margin-left: 20rpx; min-width: 0; }
.e-name { display: block; font-size: 30rpx; font-weight: 600; color: #0f172a; }
.e-meta { display: block; margin-top: 8rpx; font-size: 22rpx; color: #64748b; }
.e-call { padding: 12rpx 24rpx; background: #b45309; color: #fff; font-size: 24rpx; border-radius: 999rpx; }

.c-tabbar { position: fixed; left:0; right:0; bottom:0; z-index:999; display:flex; height: calc(104rpx + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom); background:#fff; box-shadow: 0 -4rpx 24rpx rgba(15,42,61,0.06); }
.c-tab-item { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4rpx; }
.c-tab-icon { font-size:40rpx; }
.c-tab-text { font-size:24rpx; color:#94a3b8; }
.c-tab-item--active .c-tab-text { color:#b45309; font-weight:700; }
