/* community/home.wxss */
.c-page { padding: 16rpx 28rpx 260rpx; min-height: 100vh; box-sizing: border-box; }

.c-hero {
  margin: 8rpx -28rpx 28rpx;
  padding: 40rpx 48rpx;
  background: linear-gradient(180deg, #fef3c7 0%, rgba(254,243,199,0) 100%);
}
.c-title { display:block; font-size: 48rpx; font-weight: 600; color: #0f172a; }
.c-sub { display:block; margin-top: 8rpx; font-size: 26rpx; color: #64748b; }

.c-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.c-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: #fff;
  font-size: 26rpx;
  color: #475569;
}

.c-tab--active {
  background: #b45309;
  color: #fff;
  font-weight: 600;
}

.urgent-banner {
  padding: 20rpx 28rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  background: #fef2f2;
  color: #dc2626;
  font-size: 26rpx;
  font-weight: 600;
}

.order-list { display: flex; flex-direction: column; gap: 20rpx; }

.order-card {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(15,42,61,0.06);
  padding: 28rpx;
}

.order-card--press { opacity: 0.9; }

.order-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.order-id { font-size: 22rpx; color: #94a3b8; }

.order-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.order-status--pending { background: #fef3c7; color: #b45309; }
.order-status--ontheway { background: #dbeafe; color: #1d4ed8; }
.order-status--serving { background: #dcfce7; color: #15803d; }
.order-status--done { background: #f1f5f9; color: #64748b; }

.order-body { display: flex; flex-direction: column; gap: 8rpx; }
.order-elder { font-size: 30rpx; font-weight: 600; color: #0f172a; }
.order-time, .order-addr { font-size: 24rpx; color: #475569; }

.order-foot {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f1f5f9;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-price { font-size: 26rpx; color: #b45309; font-weight: 600; }
.order-go { font-size: 26rpx; color: #0369a1; }

.empty { padding: 100rpx 0; text-align: center; }
.empty-text { font-size: 26rpx; color: #94a3b8; }

.sec-head { display: flex; align-items: center; margin: 40rpx 4rpx 20rpx; }
.sec-title { font-size: 40rpx; font-weight: 600; color: #0f172a; }

.tool-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.tool-cell {
  flex: 1;
  min-width: calc((100% - 40rpx) / 3);
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(15,42,61,0.06);
}
.tool-cell--press { opacity: 0.9; }
.tool-icon { font-size: 48rpx; }
.tool-label { font-size: 26rpx; color: #0f172a; }

/* 底部导航 */
.c-tabbar {
  position: fixed; left: 0; right: 0; bottom: 0;
  z-index: 999;
  display: flex;
  height: calc(104rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  box-shadow: 0 -4rpx 24rpx rgba(15,42,61,0.06);
}

.c-tab-item {
  flex: 1;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 4rpx;
}
.c-tab-icon { font-size: 40rpx; }
.c-tab-text { font-size: 24rpx; color: #94a3b8; }
.c-tab-item--active .c-tab-text { color: #b45309; font-weight: 700; }
