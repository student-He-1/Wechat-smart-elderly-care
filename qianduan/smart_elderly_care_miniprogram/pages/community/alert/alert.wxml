<!-- community/alert.wxml -->
<view class="a-page {{dark ? 'dark' : ''}}">
  <view class="a-list">
    <view wx:for="{{alerts}}" wx:key="id" class="a-card">
      <view class="a-head">
        <text class="a-title">{{item.title}}</text>
        <text class="a-tag {{item.handled ? 'a-tag--done' : 'a-tag--urgent'}}">{{item.handled ? '已处理' : '未处理'}}</text>
      </view>
      <text class="a-time">{{item.time}}</text>
      <image wx:if="{{item.snapshotUrl}}" class="a-shot" src="{{item.snapshotUrl}}" mode="aspectFill"
             catchtap="previewShot" data-url="{{item.snapshotUrl}}" />
      <view class="a-actions" wx:if="{{!item.handled}}">
        <button class="a-btn" size="mini" bindtap="mark" data-id="{{item.id}}" data-s="已联系">已联系</button>
        <button class="a-btn a-btn--solid" size="mini" bindtap="mark" data-id="{{item.id}}" data-s="已上门">已上门</button>
        <button class="a-btn a-btn--done" size="mini" bindtap="markDone" data-id="{{item.id}}">标记完成</button>
      </view>
    </view>
    <view wx:if="{{alerts.length === 0}}" class="empty">暂无告警</view>
  </view>

  <!-- 底部导航 -->
  <view class="c-tabbar">
    <view class="c-tab-item" bindtap="goHome"><text class="c-tab-icon">📋</text><text class="c-tab-text">工单</text></view>
    <view class="c-tab-item c-tab-item--active"><text class="c-tab-icon">🔔</text><text class="c-tab-text">告警</text></view>
    <view class="c-tab-item" bindtap="goElders"><text class="c-tab-icon">👴</text><text class="c-tab-text">老人</text></view>
    <view class="c-tab-item" bindtap="goMine"><text class="c-tab-icon">👤</text><text class="c-tab-text">我的</text></view>
  </view>
</view>
