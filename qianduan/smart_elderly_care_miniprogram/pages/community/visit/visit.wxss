/* community/visit.wxss */
.v-page { padding: 20rpx 28rpx 60rpx; }
.v-list { display: flex; flex-direction: column; gap: 20rpx; margin-bottom: 40rpx; }
.v-card { background: #fff; border-radius: 20rpx; padding: 28rpx; box-shadow: 0 4rpx 16rpx rgba(15,42,61,0.06); }
.v-head { display: flex; justify-content: space-between; align-items: center; }
.v-elder { font-size: 30rpx; font-weight: 600; color: #0f172a; }
.v-type { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 6rpx; background: #fef3c7; color: #b45309; }
.v-date { display: block; margin-top: 8rpx; font-size: 22rpx; color: #94a3b8; }
.v-note { display: block; margin-top: 16rpx; font-size: 26rpx; color: #475569; line-height: 1.5; }
.v-add { background: #b45309; color: #fff; border-radius: 999rpx; font-size: 28rpx; }
