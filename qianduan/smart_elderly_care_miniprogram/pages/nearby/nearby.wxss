/* pages/nearby/nearby.wxss */
.page-nearby {
  min-height: 100vh;
  background: linear-gradient(180deg, #eff6ff 0%, #ffffff 40%);
  padding: 32rpx 28rpx 40rpx;
  box-sizing: border-box;
}
.nearby-header {
  margin-bottom: 24rpx;
}
.nearby-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 4rpx;
}
.nearby-sub {
  display: block;
  font-size: 26rpx;
  color: #64748b;
}

/* 分类tab */
.cat-bar {
  white-space: nowrap;
  margin-bottom: 24rpx;
}
.cat-list {
  display: inline-flex;
  gap: 16rpx;
}
.cat-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 28rpx;
  background: #fff;
  border: 2rpx solid #e2e8f0;
  border-radius: 999rpx;
}
.cat-chip--active {
  background: #dbeafe;
  border-color: #60a5fa;
}
.cat-icon { font-size: 32rpx; }
.cat-name {
  font-size: 28rpx;
  color: #64748b;
  font-weight: 600;
}
.cat-chip--active .cat-name { color: #1d4ed8; }

/* 店铺列表 */
.shop-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.shop-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.06);
}
.shop-img-wrap {
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.shop-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
}
.shop-img-placeholder {
  width: 140rpx;
  height: 140rpx;
  background: #1a1a1a;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.placeholder-text {
  font-size: 20rpx;
  color: rgba(255,255,255,0.4);
  text-align: center;
}
.shop-info {
  flex: 1;
  min-width: 0;
}
.shop-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.shop-row {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}
.shop-ic { font-size: 22rpx; margin-right: 6rpx; }
.shop-address {
  font-size: 24rpx;
  color: #64748b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.shop-distance { font-size: 24rpx; color: #1d4ed8; font-weight: 600; }
.shop-dot { font-size: 22rpx; color: #cbd5e1; margin: 0 8rpx; }
.shop-hours { font-size: 22rpx; color: #94a3b8; }

.shop-call {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  background: #dbeafe;
  border-radius: 50%;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.call-ic { font-size: 32rpx; margin-bottom: 2rpx; }
.call-text { font-size: 20rpx; color: #1d4ed8; font-weight: 600; }

.nearby-footer {
  text-align: center;
  padding: 20rpx 0;
}
.footer-text {
  font-size: 22rpx;
  color: #cbd5e1;
}
