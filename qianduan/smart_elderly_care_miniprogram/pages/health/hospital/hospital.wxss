/* health/hospital.wxss */
.hosp-page { padding: 20rpx 28rpx 60rpx; }

.search-bar { margin: 8rpx 0 20rpx; }
.search-box {
  display: flex; align-items: center;
  height: 80rpx; padding: 0 28rpx;
  background: #fff; border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(15,42,61,0.06);
}
.search-icon { margin-right: 12rpx; color: #0369a1; }
.search-ph { font-size: 26rpx; color: #94a3b8; }

.city-tabs { white-space: nowrap; margin-bottom: 16rpx; }
.city-tab {
  display: inline-block;
  padding: 12rpx 28rpx; margin-right: 16rpx;
  border-radius: 999rpx;
  background: #fff;
  font-size: 26rpx; color: #475569;
}
.city-tab--active { background: #0369a1; color: #fff; font-weight: 600; }

.area-tabs { white-space: nowrap; margin-bottom: 24rpx; }
.area-tab {
  display: inline-block; margin-right: 24rpx;
  font-size: 26rpx; color: #64748b;
}

.hosp-list { display: flex; flex-direction: column; gap: 20rpx; }

.hosp-card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(15,42,61,0.06);
  padding: 24rpx;
}
.hosp-card--press { opacity: 0.9; }

.hosp-img {
  width: 160rpx; height: 120rpx;
  border-radius: 12rpx;
  background: #1f2937;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}
.hosp-img-el { width: 100%; height: 120rpx; }
.hosp-img-text { font-size: 22rpx; color: rgba(255,255,255,0.4); }

.hosp-body { flex: 1; margin-left: 20rpx; min-width: 0; }
.hosp-name { display: block; font-size: 30rpx; font-weight: 600; color: #0f172a; }
.hosp-loc { display: block; margin-top: 8rpx; font-size: 22rpx; color: #64748b; }
.hosp-addr { display: block; margin-top: 6rpx; font-size: 24rpx; color: #475569; line-height: 1.4; }
.hosp-tags { margin-top: 10rpx; display: flex; gap: 10rpx; }
.hosp-tag { font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 6rpx; }
.hosp-tag--red { background: #fee2e2; color: #dc2626; }
.hosp-tag--blue { background: #e0f2fe; color: #0369a1; }

.hosp-call {
  align-self: center;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #0369a1;
  color: #fff;
  font-size: 24rpx; font-weight: 600;
  flex-shrink: 0; margin-left: 16rpx;
}
