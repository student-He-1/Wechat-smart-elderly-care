<!-- record.wxml -->
<view class="page {{dark ? 'dark' : ''}}">
  <!-- 页头 -->
  <view class="page-header">
    <text class="section-title">健康记录</text>
    <button class="btn btn-primary btn-mini" bindtap="showAddRecordModal">添加记录</button>
  </view>

  <!-- 记录列表 -->
  <view wx:if="{{records.length > 0}}" class="record-list">
    <view wx:for="{{records}}" wx:key="id" class="record-item">
      <text class="record-text">{{item.content}}</text>
      <text class="record-time">{{item.created_at}}</text>
    </view>
  </view>

  <view wx:else class="empty">
    <text class="empty-title">暂无健康记录</text>
    <text class="empty-desc">记录血压、血糖等日常健康数据</text>
  </view>

  <!-- 添加记录弹窗 -->
  <view class="modal-mask" wx:if="{{showModal}}" bindtap="hideModal"></view>
  <view class="modal" wx:if="{{showModal}}" catchtap="">
    <text class="modal-title">添加健康记录</text>

    <view class="form-field">
      <text class="form-label">记录内容</text>
      <textarea class="textarea" placeholder="请输入健康记录…" placeholder-class="input-placeholder" value="{{formData.content}}" bindinput="bindInput" data-field="content" auto-height maxlength="500" />
    </view>

    <view class="input-methods">
      <text class="method-label">输入方式</text>
      <button class="method-pill {{inputMethod === 'voice' ? 'method-pill--active' : ''}}" bindtap="switchInputMethod">
        {{inputMethod === 'voice' ? '文字输入' : '语音输入'}}
      </button>
    </view>

    <button wx:if="{{inputMethod === 'voice'}}" class="btn btn-ghost btn-block" bindtap="startVoiceRecording">
      {{isRecording ? '停止录音' : '开始录音'}}
    </button>

    <view class="modal-footer">
      <button class="btn btn-gray" bindtap="hideModal">取消</button>
      <button class="btn btn-primary" bindtap="submitForm">添加</button>
    </view>
  </view>
</view>