/* assistant.wxss */
.page-assistant {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx 0;
}

/* 页头 */
.assistant-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  gap: 24rpx;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.clear-btn {
  min-height: 72rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-caption);
  font-weight: 500;
  color: var(--ink-600);
  background: var(--color-card);
  border-radius: var(--radius-pill);
  box-shadow: var(--shadow-card);
}

.clear-btn--press {
  background: var(--brand-100);
  color: var(--brand-700);
}

.dialect-pill {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  min-height: 72rpx;
  padding: 0 28rpx;
  background: var(--color-card);
  box-shadow: var(--shadow-card);
  border-radius: var(--radius-pill);
  flex-shrink: 0;
}

.dialect-label {
  font-size: var(--fs-caption);
  color: var(--ink-600);
}

.dialect-value {
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--ink-800);
}

/* 常见问题：大胶囊，易点按 */
.questions-wrap {
  margin-bottom: 24rpx;
}

.marquee {
  overflow: hidden;
  white-space: nowrap;
  margin-bottom: 14rpx;
}

.marquee:last-child {
  margin-bottom: 0;
}

.marquee-track {
  display: inline-flex;
  gap: 16rpx;
  width: max-content;
  animation: marqueeL 22s linear infinite;
}

.marquee--reverse .marquee-track {
  animation: marqueeR 22s linear infinite;
}

@keyframes marqueeL {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

@keyframes marqueeR {
  from { transform: translateX(-50%); }
  to { transform: translateX(0); }
}

.question-chip {
  flex-shrink: 0;
  min-height: 80rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-caption);
  font-weight: 500;
  color: var(--ink-700);
  background: var(--color-card);
  border-radius: var(--radius-pill);
  box-shadow: var(--shadow-card);
  line-height: 1.3;
}

.question-chip--press {
  background: var(--brand-100);
  color: var(--brand-700);
}

/* 聊天记录 */
.chat-history {
  flex: 1;
  overflow-y: auto;
  background: var(--color-card);
  border-radius: var(--radius-xl);
  padding: 32rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}

.chat-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 36rpx;
}

.chat-row--user {
  flex-direction: row-reverse;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-caption);
  font-weight: 700;
  flex-shrink: 0;
}

.avatar-ai {
  background: var(--brand-600);
  color: #ffffff;
  margin-right: 20rpx;
  overflow: hidden;
}

.avatar-user {
  background: var(--safe);
  color: #ffffff;
  margin-left: 20rpx;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.bubble {
  max-width: 72%;
  padding: 26rpx 30rpx;
  border-radius: var(--radius-xl);
}

.bubble-user {
  background: var(--brand-600);
  border-bottom-right-radius: 8rpx;
}

.bubble-ai {
  background: var(--brand-50);
  border-bottom-left-radius: 8rpx;
}

.bubble-text {
  display: block;
  font-size: var(--fs-body);
  line-height: 1.65;
  color: var(--ink-800);
  word-break: break-word;
}

.bubble-user .bubble-text {
  color: #ffffff;
}

.term-chip {
  display: inline;
  color: var(--brand-700);
  background: var(--brand-100);
  padding: 2rpx 14rpx;
  border-radius: 10rpx;
  margin: 0 4rpx;
  font-weight: 600;
  border-bottom: 4rpx solid var(--brand-400, var(--brand-600));
}

.term-chip--press {
  opacity: 0.7;
}

.think-box {
  margin-bottom: 16rpx;
  padding: 14rpx 18rpx;
  background: rgba(0, 0, 0, 0.04);
  border-left: 6rpx solid rgba(0, 0, 0, 0.15);
  border-radius: 10rpx;
}
.think-head {
  display: flex;
  align-items: center;
}
.think-title {
  font-size: 22rpx;
  color: #999;
}
.think-text {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
  font-style: italic;
  line-height: 1.6;
  white-space: pre-wrap;
}

.speak-btn {
  margin-top: 20rpx;
  min-height: 72rpx;
  padding: 0 28rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--brand-700);
  background: #ffffff;
  border-radius: var(--radius-pill);
}

.speak-btn:active {
  opacity: 0.75;
}

/* 输入区域 */
.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.chat-input {
  flex: 1;
  min-height: 96rpx;
  padding: 0 32rpx;
  font-size: var(--fs-body);
  background: var(--color-canvas-secondary);
  border-radius: var(--radius-pill);
  color: var(--ink-800);
}

.chat-input-placeholder {
  color: var(--ink-500);
}

.send-btn {
  min-height: 96rpx;
  padding: 0 44rpx;
  flex-shrink: 0;
}

/* 语音输入按钮 */
.voice-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--brand-100);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1;
  flex-shrink: 0;
}

.voice-btn::after {
  border: none;
}

.voice-btn.is-recording {
  background: var(--danger);
}


/* ===== 图标化补充（v3） ===== */
.speak-ic {
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
}
