/* talk.wxss —— AI 聊天二级页 */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-canvas);
  box-sizing: border-box;
}

.chat-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: var(--color-card);
  border-bottom: 1rpx solid var(--color-hairline);
}

.dialect-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: var(--color-canvas-secondary);
}

.dialect-label {
  font-size: var(--fs-caption);
  color: var(--ink-600);
}

.dialect-value {
  font-size: var(--fs-label);
  font-weight: 700;
  color: var(--brand-700);
}

.dialect-arrow {
  width: 28rpx;
  height: 28rpx;
}

.chat-history {
  flex: 1;
  min-height: 0;
  padding: 28rpx 28rpx 16rpx;
}

.chat-row {
  display: flex;
  align-items: flex-start;
  width: 100%;
  margin-bottom: 30rpx;
}

.chat-row--user {
  flex-direction: row-reverse;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 14rpx rgba(15, 42, 61, 0.14);
}

.avatar-ai {
  background: linear-gradient(145deg, #0ea5e9, #0369a1);
  margin-right: 20rpx;
  overflow: hidden;
}

.avatar-user {
  background: linear-gradient(145deg, #34d399, #15803d);
  margin-left: 20rpx;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.bubble {
  max-width: 480rpx;
  padding: 22rpx 26rpx;
  border-radius: var(--radius-lg);
}

.bubble-ai {
  background: var(--color-card);
  border: 1rpx solid var(--color-hairline);
  border-top-left-radius: 8rpx;
  box-shadow: var(--shadow-card);
}

.bubble-user {
  background: var(--brand-600);
  border-top-right-radius: 8rpx;
  box-shadow: var(--shadow-float);
}

.bubble-user .bubble-text {
  color: #ffffff;
}

.bubble-text {
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--ink-800);
  white-space: pre-wrap;
  word-break: break-word;
}

.bubble-in {
  animation: bubbleIn 0.22s ease both;
}

@keyframes bubbleIn {
  from { opacity: 0; transform: translateY(12rpx) scale(0.97); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx 20rpx;
  background: var(--color-card);
  border-top: 1rpx solid var(--color-hairline);
}

.chat-input {
  flex: 1;
  height: 84rpx;
  padding: 0 28rpx;
  font-size: var(--fs-body);
  background: var(--color-canvas-secondary);
  border-radius: 999rpx;
  color: var(--ink-900);
}

.chat-input-placeholder {
  color: var(--ink-500);
}

.voice-btn {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: var(--brand-100);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1;
}

.voice-btn::after {
  border: none;
}

.voice-btn.is-recording {
  background: var(--danger);
}

.send-btn {
  width: 148rpx;
  min-height: 84rpx;
  height: 84rpx;
  padding: 0;
  margin: 0;
  border-radius: 999rpx;
  font-size: var(--fs-label);
}

.bubble-play{margin-top:12rpx;display:inline-flex;align-items:center;justify-content:center;width:56rpx;height:56rpx;border-radius:50%;background:rgba(3,105,161,.08);}

.clear-btn{font-size:26rpx;color:var(--ink-600);padding:10rpx 24rpx;border-radius:999rpx;background:var(--color-canvas-secondary);}
